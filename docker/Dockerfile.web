# ============================================================
# Aprender IA — build de produção do app Next.js
# Multi-stage para manter a imagem final enxuta.
# ============================================================

FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

# ------------------------------------------------------------
# 1) Dependências — camada cacheável
# ------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/ui/package.json ./packages/ui/
COPY packages/auth/package.json ./packages/auth/
COPY packages/types/package.json ./packages/types/
COPY packages/config/package.json ./packages/config/
COPY packages/ai-launcher/package.json ./packages/ai-launcher/

# O cache montado guarda a store do pnpm ENTRE builds, e é o que salva o
# deploy quando o lockfile muda.
#
# Sem ele, qualquer alteração em `pnpm-lock.yaml` invalida esta camada e
# obriga a rebaixar os ~217 pacotes do zero. Na VPS isso levou mais de 38
# minutos e estourou o `timeout-minutes: 45` do workflow — um deploy
# perdido por causa de uma dependência de desenvolvimento adicionada.
#
# Com o cache, só os pacotes realmente novos são baixados; os demais saem
# da store local (aparecem como `reused` no log) e o install volta à casa
# dos segundos.
RUN --mount=type=cache,id=pnpm-store,target=/pnpm-store \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile

# ------------------------------------------------------------
# 2) Build
# ------------------------------------------------------------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/packages ./packages
COPY . .

# O Prisma Client precisa existir antes do build do Next
RUN pnpm --filter @aprender/db exec prisma generate

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
# Garante que public/ exista: o git não versiona diretório vazio e o
# COPY do estágio runner falharia se o repo não a trouxesse.
RUN mkdir -p apps/web/public && pnpm --filter @aprender/web build

# ------------------------------------------------------------
# 3) Runtime — só o necessário para servir
# ------------------------------------------------------------
FROM node:22-alpine AS runner
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# Copiamos já com o dono correto. Um `chown -R` depois percorreria
# dezenas de milhares de arquivos de node_modules — é lento e falha
# com I/O error em alguns storage drivers do Docker.
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/packages ./packages
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next ./apps/web/.next
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/package.json ./apps/web/
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/next.config.mjs ./apps/web/
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

WORKDIR /app/apps/web
CMD ["node_modules/.bin/next", "start"]
