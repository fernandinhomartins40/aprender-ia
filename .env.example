# Banco de dados
DATABASE_URL="postgresql://aprender:aprender_dev@localhost:5544/aprender_ia?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-uma-chave-aleatoria-de-32-caracteres"

# A plataforma entra apenas por identificador (e-mail ou telefone) + senha.
# Não há login social: nenhum provider OAuth está configurado.

# Envio de e-mail (recuperação de senha).
# Sem estas variáveis o link NÃO é enviado: ele aparece no log do servidor,
# o que serve para desenvolver, mas não atende o professor em produção.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Aprender IA <nao-responda@aprenderia.site>"

# Reengajamento automático em produção. Mantenha o segredo igual ao do
# serviço web; o intervalo só agenda verificações, não ignora anti-spam.
#
# 86400 (24h) e não 3600 (1h): o motor deduplica em 24h/72h/168h, então com
# intervalo de uma hora 23 das 24 execuções diárias percorriam todos os
# alunos, montavam a trilha completa de cada um (`carregarTrilha` são 4+
# consultas por aluno) e descartavam o resultado na deduplicação. Nenhum
# aviso deixa de chegar: o dedupe já os limitava a um por dia.
CRON_SECRET=""
ENGAGEMENT_INTERVAL_SECONDS="86400"
