// Aprender IA — schema do banco
// PostgreSQL 16

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUÁRIOS E AUTENTICAÇÃO
// ============================================================

enum Papel {
  ALUNO
  INSTRUTOR
  ADMIN
}

/// Plano de acesso do aluno. FREE só alcança cursos gratuitos.
enum Plano {
  FREE
  PREMIUM
}

/// Situação da conta. SUSPENSO bloqueia o acesso a curso pago,
/// mas preserva todo o progresso já feito.
enum SituacaoConta {
  ATIVO
  SUSPENSO
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String?  @unique
  senhaHash String?
  avatar    String?
  papel     Papel    @default(ALUNO)

  // Contas criadas em lote nascem com senha provisória; o aluno é
  // obrigado a definir a sua no primeiro acesso.
  precisaTrocarSenha Boolean @default(false)

  // ---- Acesso e cobrança ----
  plano       Plano         @default(FREE)
  situacao    SituacaoConta @default(ATIVO)
  /// Até quando o acesso premium vale. Nulo = sem prazo definido.
  premiumAte  DateTime?
  observacoes String?       @db.Text

  // perfil docente
  disciplina String?
  anoEscolar String?
  escola     String?
  iaFavorita String?

  emailVerificado DateTime?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  /// Carimbado a cada login. Sem ele não existe "aluno ativo" nem
  /// "inativo": `Streak.ultimoAcesso` só se move quando o aluno conclui
  /// uma lição, e entrar sem estudar também é acesso.
  ultimoAcessoEm DateTime?

  // ---- Acesso gratuito ----
  /// Até quando o acesso gratuito vale. Nulo = sem prazo (permanente),
  /// que é o estado das contas criadas antes desta regra existir.
  freeAte         DateTime?
  /// Quando o prazo atual foi concedido — base do histórico de acessos.
  freeConcedidoEm DateTime?
  /// Revogação manual pelo administrador. Preenchido, corta o acesso
  /// mesmo que `freeAte` ainda esteja no futuro.
  freeRevogadoEm  DateTime?

  contas           Account[]
  sessoes          Session[]
  tokensSenha      PasswordResetToken[]
  matriculas       Enrollment[]
  execucoesPrompt  PromptRun[]
  favoritosPrompt  PromptFavorite[]
  ofensiva         Streak?
  conquistas       UserAchievement[]
  membroTurmas     CohortMember[]
  turmasQueMinistro Cohort[]         @relation("TurmasQueMinistro")
  presencas        MeetingAttendance[]
  registrosDiario  DiaryEntry[]
  pagamentos       Payment[]
  assinaturas      Subscription[]
  notificacoes     Notification[]
  inscricoesPush   PushSubscription[]
  preferenciasNotificacao NotificationPreference?
  missoesUsuario   UserMission[]
  recompensas      UserReward[]
  desempenhos      ActivityPerformance[]
  /// O que marcou e digitou em cada passo do "Acompanhe a Aula".
  passosDaAula     StepProgress[]
  /// O que o cursista produziu nos laboratórios e no projeto final —
  /// o material que ele leva para fora do curso.
  versoesPrompt    PromptUserVersion[]
  entregasLab      LabDelivery[]
  projetosFinais   FinalProject[]

  acoesAdmin       AdminAuditLog[]  @relation("AtorDaAcao")
  solicitacoes     AccessRequest[]  @relation("SolicitanteDoAcesso")
  solicitacoesDecididas AccessRequest[] @relation("DecisorDoAcesso")

  @@index([papel])
  @@index([telefone])
  @@index([plano])
  @@index([situacao])
  @@index([ultimoAcessoEm])
  @@index([freeAte])
  @@map("users")
}

// ============================================================
// SOLICITAÇÃO DE ACESSO GRATUITO
// ============================================================

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  RECUSADA
}

/// Pedido de (re)liberação de acesso gratuito.
///
/// Nunca libera nada sozinho: existe justamente para que a liberação
/// passe pelo administrador. Guarda o prazo que expirou e quantos dias
/// foram concedidos, para o histórico responder "quantas vezes essa
/// pessoa já pediu, e o que foi dado" sem cruzar tabelas.
model AccessRequest {
  id     String            @id @default(cuid())
  userId String
  status StatusSolicitacao @default(PENDENTE)

  /// O que o aluno escreveu ao pedir. Opcional — exigir justificativa
  /// afasta justamente quem tem mais vergonha de pedir.
  motivo String? @db.Text

  /// Estado no momento do pedido, congelado para auditoria.
  expiradoEm      DateTime?
  /// Qual pedido é este para esta pessoa (1º, 2º…).
  ordem           Int       @default(1)

  // ---- Decisão ----
  decididoEm  DateTime?
  decididoPor String?
  decisorNome String?
  /// Dias concedidos na aprovação; nulo numa recusa.
  diasConcedidos Int?
  /// Anotação do administrador — o aluno não vê.
  observacao     String?  @db.Text

  criadoEm DateTime @default(now())

  user    User  @relation("SolicitanteDoAcesso", fields: [userId], references: [id], onDelete: Cascade)
  /// Quem decidiu sai sem apagar o pedido: o vínculo fica nulo.
  decisor User? @relation("DecisorDoAcesso", fields: [decididoPor], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([criadoEm])
  @@map("access_requests")
}

// ============================================================
// CONFIGURAÇÕES DA PLATAFORMA
// ============================================================

/// Tipo do valor guardado, para o painel renderizar o campo certo e
/// converter na leitura sem adivinhar.
enum TipoConfiguracao {
  TEXTO
  NUMERO
  BOOLEANO
  JSON
}

/// Configuração da plataforma, editável pelo painel.
///
/// Chave/valor em vez de colunas: cada fase nova (regras do Free, planos,
/// notificações) acrescenta chaves sem migration. O valor é sempre texto
/// e `tipo` diz como convertê-lo — assim uma chave nova não exige tocar
/// no schema, que é justamente o objetivo de não depender do banco.
model PlatformSetting {
  chave     String           @id
  valor     String           @db.Text
  tipo      TipoConfiguracao @default(TEXTO)
  /// Agrupa as chaves em seções na tela de configurações.
  grupo     String           @default("geral")
  rotulo    String
  descricao String?          @db.Text

  atualizadoEm  DateTime @updatedAt
  atualizadoPor String?

  @@index([grupo])
  @@map("platform_settings")
}

// ============================================================
// AUDITORIA ADMINISTRATIVA
// ============================================================

/// Registro de ação administrativa.
///
/// Guarda o nome do ator junto do id: se a conta for apagada depois, o
/// log continua dizendo quem fez — um histórico que se apaga sozinho não
/// serve como histórico.
model AdminAuditLog {
  id        String @id @default(cuid())
  atorId    String?
  atorNome  String
  /// Verbo curto e estável, ex.: "aluno.plano.alterado".
  acao      String
  /// Que tipo de registro foi afetado ("User", "Cohort", "Payment").
  entidade  String
  entidadeId String?
  /// Descrição legível, para a tela não precisar interpretar `dados`.
  resumo    String
  /// Antes/depois e o que mais ajudar a entender a ação.
  dados     Json?

  ip        String?
  userAgent String? @db.Text

  criadoEm DateTime @default(now())

  ator User? @relation("AtorDaAcao", fields: [atorId], references: [id], onDelete: SetNull)

  @@index([atorId])
  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@index([acao])
  @@map("admin_audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Token de recuperação de senha.
///
/// Não reaproveitamos VerificationToken: aquele pertence ao Auth.js, que
/// o apaga em seus próprios fluxos, e não tem como registrar que um token
/// já foi usado. Aqui guardamos apenas o HASH do token — vazamento do
/// banco não permite redefinir a senha de ninguém.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  /// Guardados para auditoria de pedidos suspeitos.
  ip        String?
  userAgent String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiraEm])
  @@map("password_reset_tokens")
}

// ============================================================
// CURSO E TRILHA
// ============================================================

model Course {
  id           String  @id @default(cuid())
  slug         String  @unique
  titulo       String
  subtitulo    String?
  descricao    String  @db.Text
  capa         String?
  cargaHoraria Int     @default(40)
  publicado    Boolean @default(false)
  ordem        Int     @default(0)

  /// Curso pago exige plano PREMIUM e conta ativa.
  pago         Boolean @default(false)
  /// Valor de referência para o controle financeiro, em centavos.
  precoCentavos Int    @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  modulos    Module[]
  matriculas Enrollment[]
  turmas     Cohort[]
  planos     PlanCourse[]

  /// Conteúdo de apoio com escopo de curso. Em todos estes o `courseId`
  /// nulo significa "vale para todos os cursos": era o comportamento de
  /// quando a plataforma tinha um curso só, e é o que mantém o acervo
  /// do curso de Educadores no lugar sem precisar reescrevê-lo.
  promptTemplates PromptTemplate[]
  ferramentas     AiTool[]
  conhecimento    KnowledgeEntry[]
  missoes         Mission[]
  conquistas      Achievement[]
  capitulos       HandbookChapter[]
  roteiros        LessonScript[]
  projetosFinais  FinalProject[]

  @@map("courses")
}

model Module {
  id        String  @id @default(cuid())
  courseId  String
  titulo    String
  subtitulo String?
  descricao String? @db.Text
  ordem     Int
  icone     String?
  cor       String? // cor do encontro (#6366F1, #0EA5E9, ...)

  /// Módulo do plano pago. O bloqueio do curso continua existindo em
  /// `Course.pago`; este desce o controle um nível, para que a trilha
  /// AVANÇADA conviva com os encontros gratuitos no mesmo curso.
  pago  Boolean @default(false)
  /// Selo curto na trilha ("Extra", "Avançado"). Nulo nos encontros.
  faixa String?

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  licoes Lesson[]
  planos PlanModule[]

  @@unique([courseId, ordem])
  @@map("modules")
}

enum TipoLicao {
  TEORIA
  PROMPT
  DUELO
  CACA_ERRO
  CASO
  DESAFIO
  QUIZ
  CHECKPOINT
  /// Abre cada encontro: uma pergunta que liga o conteúdo à dor real
  /// antes da teoria. Na apostila são 4, um por encontro.
  AQUECIMENTO
  /// O cursista faz agora, no próprio celular — o formato existe para
  /// quem não tem computador em casa nem laboratório na escola.
  NO_CELULAR
  /// Guia de Bolso (Cap. 12): prompt de emergência para o imprevisto
  /// da rotina, consultado na hora do aperto.
  EMERGENCIA
  /// O cursista produz algo e a entrega fica salva (`LabDelivery`).
  /// Diferente de DESAFIO, que é cronometrado e não guarda resultado.
  LABORATORIO
  /// Mesma tarefa em duas colunas — como era antes da IA e como fica
  /// com ela —, com o tempo economizado explícito.
  ANTES_DEPOIS
  /// Diagrama de um processo passo a passo (o lead que entra, o pedido
  /// que chega). Ensina a lógica antes de abrir qualquer ferramenta.
  FLUXO
  /// Projeto final: o cursista preenche ao longo do curso e leva o
  /// plano pronto para fora dele.
  PROJETO
}

model Lesson {
  id             String    @id @default(cuid())
  moduleId       String
  titulo         String
  subtitulo      String?
  tipo           TipoLicao
  conteudo       Json // estrutura varia conforme o tipo
  ordem          Int
  xpRecompensa   Int       @default(10)
  tempoEstimado  Int       @default(5) // minutos
  capituloRef    String? // "Cap. 2.2" — liga à apostila

  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  promptTemplates PromptTemplate[]
  exercicios      Exercise[]
  progressos      LessonProgress[]
  desempenhos     ActivityPerformance[]
  missoes         Mission[]
  entregasLab     LabDelivery[]

  @@unique([moduleId, ordem])
  @@index([tipo])
  @@map("lessons")
}

// ============================================================
// PROMPTS — o diferencial da aplicação
// ============================================================

model PromptTemplate {
  id       String  @id @default(cuid())
  lessonId String?
  /// Curso dono do prompt. Nulo = acervo comum, visível em qualquer
  /// curso — é o que o banco de Educadores era antes de a plataforma
  /// ter mais de um curso.
  courseId String?

  titulo    String
  corpo     String  @db.Text
  variaveis Json // [{ chave: "ANO", rotulo: "Ano escolar", exemplo: "6º ano" }]
  categoria String // "planejamento" | "avaliacao" | "inclusao" | ...
  disciplina String?
  dica      String? @db.Text
  /// Referência verificável: capítulo da apostila ou extensão pedagógica.
  origem    String?
  /// Gratuito, Extra ou Avançado. A biblioteca usa esta faixa para não
  /// prometer a usuários FREE um material que o servidor bloqueia.
  faixa     String  @default("Gratuito")
  etapaEnsino String?
  /// Análogos de `disciplina` e `etapaEnsino` para cursos de negócio:
  /// "vendas", "atendimento", "financeiro"… e o porte a que o prompt
  /// serve ("MEI", "pequena empresa"). Nulos no curso de Educadores.
  setor String?
  porteEmpresa String?
  /// O prompt já preenchido com um caso real, para o cursista ver o
  /// que se espera antes de escrever o dele.
  exemploPreenchido String? @db.Text
  objetivoPedagogico String?
  tipoAtividade String?
  nivelDificuldade String?
  tags String[] @default([])

  ferramentasSugeridas String[] // ["gemini", "deepseek", "chatgpt"]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  lesson    Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  course    Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  execucoes PromptRun[]
  favoritos PromptFavorite[]
  versoes   PromptUserVersion[]

  @@index([categoria])
  @@index([disciplina])
  @@index([etapaEnsino])
  @@index([courseId])
  @@index([setor])
  @@map("prompt_templates")
}

/// Versão que o cursista salvou de um prompt da biblioteca, depois de
/// adaptá-lo ao próprio negócio. O original continua intocado: cada um
/// guarda a sua, e a do vizinho não aparece.
model PromptUserVersion {
  id               String @id @default(cuid())
  userId           String
  promptTemplateId String

  titulo String?
  corpo  String  @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@unique([userId, promptTemplateId])
  @@index([userId])
  @@map("prompt_user_versions")
}

/// Catálogo administrável de ferramentas externas. URLs ficam no banco para
/// que trocar uma ferramenta não exija publicar uma nova versão do PWA.
model AiTool {
  id           String   @id @default(cuid())
  chave        String   @unique
  /// Nulo = ferramenta do catálogo comum, listada em qualquer curso.
  courseId     String?
  nome         String
  descricao    String   @db.Text
  categoria    String
  url          String
  urlCadastro  String?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  /// Capacidades normalizadas: textos, planejamento, pesquisa, imagens, apresentação...
  capacidades  String[] @default([])
  entradas     String[] @default(["texto"])
  saidas       String[] @default(["texto"])
  /// COPIAR_E_ABRIR é o padrão seguro; URL_COM_PROMPT só com URL oficial verificada.
  metodoAbertura String @default("COPIAR_E_ABRIR")
  urlComPrompt String?
  observacaoIntegracao String? @db.Text

  /// GRATUITO | GRATUITO_COM_LIMITES | PAGO | DEPENDE_DO_PLANO.
  /// O curso promete priorizar o que é acessível, e prometer isso sem
  /// registrar a faixa é como o cursista descobre, tarde, que a aula
  /// dependia de assinatura.
  faixaAcesso String @default("GRATUITO_COM_LIMITES")
  /// O limite concreto, na linguagem de quem vai esbarrar nele:
  /// "50 fontes por notebook", "1.000 operações por mês".
  limiteGratuito String? @db.Text
  /// Data da última conferência na documentação oficial. Ferramenta de
  /// IA muda rápido; sem isto não há como saber se a aula envelheceu.
  verificadoEm DateTime?
  fonteUrl     String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ativo, ordem])
  @@index([courseId])
  @@map("ai_tools")
}

model PromptFavorite {
  id String @id @default(cuid())
  userId String
  promptTemplateId String
  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@unique([userId, promptTemplateId])
  @@index([userId, criadoEm])
  @@map("prompt_favorites")
}

/// Base editorial reutilizada pela Central e pelos popovers contextuais.
model KnowledgeEntry {
  id String @id @default(cuid())
  slug String @unique
  /// Nulo = verbete do acervo comum (o que já existia).
  courseId String?
  termo String
  sinonimos String[] @default([])
  categoria String
  resumo String @db.Text
  explicacao String @db.Text
  importancias Json? // { planejamento: "...", prompts: "..." }
  fonteNome String?
  fonteUrl String?
  saibaMaisUrl String?
  relacionadoSlugs String[] @default([])
  publicado Boolean @default(true)
  atualizadoEm DateTime @updatedAt
  criadoEm DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([publicado, categoria])
  @@index([termo])
  @@index([courseId])
  @@map("knowledge_entries")
}

model PromptRun {
  id               String @id @default(cuid())
  userId           String
  promptTemplateId String

  ferramenta           String // "gemini" | "deepseek" | ...
  variaveisPreenchidas Json
  promptFinal          String  @db.Text
  reflexao             String? @db.Text
  minutosEconomizados  Int?

  executadoEm DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promptTemplateId])
  @@index([ferramenta])
  @@map("prompt_runs")
}

// ============================================================
// EXERCÍCIOS
// ============================================================

enum TipoExercicio {
  MULTIPLA_ESCOLHA
  VERDADEIRO_FALSO
  RESPOSTA_LIVRE
  REESCRITA_PROMPT
  ENCONTRAR_ERRO
}

model Exercise {
  id       String        @id @default(cuid())
  lessonId String
  tipo     TipoExercicio
  enunciado String       @db.Text
  opcoes    Json? // [{ id, texto, correta }]
  respostaCorreta String? @db.Text
  explicacao      String  @db.Text
  ordem           Int

  lesson    Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  respostas ExerciseResponse[]

  @@unique([lessonId, ordem])
  @@map("exercises")
}

model ExerciseResponse {
  id         String  @id @default(cuid())
  exerciseId String
  progressId String

  resposta String  @db.Text
  correta  Boolean
  tentativa Int    @default(1)

  respondidoEm DateTime @default(now())

  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  progress LessonProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId])
  @@map("exercise_responses")
}

/// Resposta escrita pelo aluno numa atividade de texto livre.
///
/// Separada de `ExerciseResponse` por duas razões: aquela exige um
/// `Exercise` cadastrado, e estas lições guardam o enunciado no JSON de
/// `Lesson`; e aquela resume o resultado em `correta Boolean`, enquanto
/// um prompt não é certo ou errado — o motor P.T.C.F. devolve quatro
/// dimensões em três estados cada.
///
/// `analise` guarda o veredito do momento do envio em vez de recalcular
/// na leitura: o motor vai evoluir, e sem isto uma análise feita hoje
/// mudaria sozinha a cada ajuste no léxico, deixando o histórico
/// diferente do que a pessoa realmente viu na tela.
model RespostaAberta {
  id         String @id @default(cuid())
  progressId String

  /// Qual campo dentro da lição. Hoje sempre "principal".
  chave     String @default("principal")
  texto     String @db.Text
  analise   Json?
  /// Quantas das quatro letras foram detectadas. Atalho para o painel
  /// ordenar e filtrar sem precisar abrir o JSON.
  completas Int    @default(0)
  tentativa Int    @default(1)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  progress LessonProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, chave])
  @@index([progressId])
  @@map("respostas_abertas")
}

/// O que o cursista produziu numa lição de LABORATORIO.
///
/// Fica preso ao usuário e à lição, e não ao `LessonProgress`, porque
/// a entrega sobrevive a refazer a lição: quem volta ao laboratório
/// continua de onde parou, em vez de encontrar a folha em branco.
model LabDelivery {
  id       String @id @default(cuid())
  userId   String
  lessonId String

  /// A entrega, no formato que cada laboratório define: o texto da
  /// resposta ao cliente, os passos do procedimento, as caixas do
  /// fluxo de automação.
  conteudo Json
  /// O cursista deu por pronta. Enquanto falso é rascunho, e o painel
  /// não cobra qualidade de rascunho.
  concluida Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lab_deliveries")
}

/// "Minha Empresa Aumentada por IA": o projeto que atravessa o curso.
///
/// O cursista preenche as seções ao longo dos módulos, e no fim leva o
/// Plano de Adoção — que precisa fazer sentido fora do curso, lido por
/// quem nunca viu a plataforma.
model FinalProject {
  id       String @id @default(cuid())
  userId   String
  courseId String

  /// O negócio escolhido: { nome, ramo, porte, fictício? }.
  negocio Json
  /// Uma chave por seção do plano — tarefas repetitivas, oportunidades,
  /// processo a automatizar, marketing, dados, agente. Json porque as
  /// seções mudam com o curso, e cada mudança dessas não deve virar
  /// migração de banco.
  secoes  Json @default("{}")

  concluidoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@map("final_projects")
}

// ============================================================
// MATRÍCULA E PROGRESSO
// ============================================================

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String

  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?
  progressoPct Int       @default(0)
  xpTotal      Int       @default(0)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressos LessonProgress[]

  @@unique([userId, courseId])
  @@map("enrollments")
}

enum StatusLicao {
  BLOQUEADA
  DISPONIVEL
  EM_ANDAMENTO
  CONCLUIDA
}

model LessonProgress {
  id           String      @id @default(cuid())
  enrollmentId String
  lessonId     String
  status       StatusLicao @default(BLOQUEADA)
  xpGanho      Int         @default(0)
  tentativas   Int         @default(0)
  anotacoes    String?     @db.Text

  iniciadoEm  DateTime?
  concluidoEm DateTime?

  enrollment Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  respostas  ExerciseResponse[]
  abertas    RespostaAberta[]

  @@unique([enrollmentId, lessonId])
  @@index([status])
  @@map("lesson_progress")
}

// ============================================================
// GAMIFICAÇÃO
// ============================================================

model Streak {
  id           String   @id @default(cuid())
  userId       String   @unique
  diasSeguidos Int      @default(0)
  recorde      Int      @default(0)
  ultimoAcesso DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

model Achievement {
  id        String @id @default(cuid())
  chave     String @unique
  /// Nulo = conquista da plataforma, válida em qualquer curso.
  courseId  String?
  titulo    String
  descricao String
  icone     String
  criterio  Json // { tipo: "licoes_concluidas", valor: 10 }
  ordem     Int    @default(0)
  oculto    Boolean @default(false)
  recompensaTitulo String?

  usuarios UserAchievement[]
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  conquistadoEm DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ============================================================
// DIÁRIO DE BORDO
// ============================================================

/// Como o registro nasceu. Muda o que a interface mostra e, sobretudo, o
/// que a aplicação pode afirmar sobre ele.
enum OrigemRegistro {
  /// O professor escreveu. É a palavra dele — nunca reescrita.
  MANUAL
  /// Derivado de uso real da aplicação (usou um prompt, concluiu uma
  /// lição). Descreve o que aconteceu, jamais o que deu certo.
  AUTOMATICO
  /// Automático que o professor confirmou. Vale como manual daí em diante.
  CONFIRMADO
}

/// O que o registro é, pedagogicamente. Atribuída por léxico
/// determinístico; o professor pode corrigir.
enum CategoriaRegistro {
  AULA
  PLANEJAMENTO
  ATIVIDADE
  AVALIACAO
  ESTRATEGIA
  DIFICULDADE
  ADAPTACAO
  OBSERVACAO
  RESULTADO
  IDEIA_FUTURA
  RECURSO
  REFLEXAO
}

model DiaryEntry {
  id     String @id @default(cuid())
  userId String

  // ---- Campos originais ----
  // Preservados: os registros que já existem continuam válidos e
  // aparecem na linha do tempo sem migração de conteúdo.
  //
  // `ferramentaUsada` deixou de ser obrigatório. Nem toda prática
  // pedagógica passa por uma ferramenta de IA, e exigir a escolha de uma
  // era parte da burocracia que mantinha o diário vazio.
  oQueFez             String  @db.Text
  ferramentaUsada     String?
  minutosAntes        Int?
  minutosAgora        Int?
  valeuAPena          Boolean @default(true)
  observacao          String? @db.Text

  // ---- Camada de conhecimento ----
  origem    OrigemRegistro     @default(MANUAL)
  categoria CategoriaRegistro?

  /// Assunto trabalhado ("frações", "meio ambiente"). Extraído do que o
  /// professor já preencheu em outro lugar — nunca adivinhado.
  tema       String?
  disciplina String?
  /// Ano/série como o professor escreveu ("6º ano"), sem normalizar para
  /// código: a forma dele é a que ele reconhece meses depois.
  etapa      String?
  /// Palavras-chave para busca e para os resumos.
  marcadores String[] @default([])

  /// De onde veio, quando automático: "promptRun", "licao". Com `fonteId`,
  /// impede que o mesmo evento vire dois registros e permite abrir a
  /// origem a partir da linha do tempo.
  fonteTipo String?
  fonteId   String?

  /// Sugestão ainda não decidida. Sugestões não entram na linha do tempo
  /// nem alimentam resumos: só viram memória se o professor aceitar. É o
  /// que impede o diário de encher de coisa que ele não pediu.
  pendente Boolean @default(false)

  registradoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, registradoEm])
  @@index([userId, pendente])
  @@index([userId, categoria])
  /// Um evento, um registro. Reabrir a tela ou repetir a ação não duplica
  /// a memória. (Em Postgres, NULLs não colidem: registros manuais, que
  /// não têm fonte, ficam livres desta restrição.)
  @@unique([userId, fonteTipo, fonteId])
  @@map("diary_entries")
}

// ============================================================
// FINANCEIRO
// ============================================================

enum TipoPagamento {
  UNICO
  RECORRENTE
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

/// Periodicidade de um plano pago.
enum Periodicidade {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  /// Cobrança única que libera acesso por um número de dias.
  UNICA
}

/// Ciclo de vida de uma assinatura.
///
/// INADIMPLENTE não é o mesmo que CANCELADA: o vínculo continua de pé e o
/// aluno volta ao quitar. Só CANCELADA e EXPIRADA encerram a assinatura.
enum StatusAssinatura {
  /// Vale acesso.
  ATIVA
  /// Criada, aguardando confirmação do primeiro pagamento. NÃO vale
  /// acesso — é o estado de quem escolheu um plano e ainda não pagou.
  PENDENTE
  /// Cobrança vencida. Vale acesso até o fim do ciclo já pago; depois
  /// disso o prazo é que decide, não o status.
  INADIMPLENTE
  /// Suspensa pela administração, sem cancelar o vínculo. Não vale
  /// acesso enquanto durar.
  SUSPENSA
  /// Encerrada pelo aluno ou pelo admin. Vale acesso até o fim do ciclo
  /// já pago — quem pagou o mês tem direito ao mês.
  CANCELADA
  /// Prazo esgotado. Não vale acesso.
  EXPIRADA
}

/// Como um plano concede conteúdo.
///
/// Distingue os dois casos que antes se confundiam: o plano que dá o
/// curso inteiro (e continua dando quando módulos novos são publicados)
/// e o plano que dá um recorte fixo de módulos.
enum AbrangenciaPlano {
  /// Curso inteiro, incluindo módulos criados depois.
  CURSO_COMPLETO
  /// Apenas os módulos listados em `PlanModule`.
  MODULOS_ESPECIFICOS
}

/// Um plano vendável — ou o plano gratuito da plataforma.
///
/// O preço mora aqui e não no código: criar uma promoção não deve exigir
/// deploy, que é justamente o objetivo do painel.
///
/// O que este modelo ganhou: um plano agora DIZ QUE CONTEÚDO LIBERA
/// (`cursos`). Antes definia só preço e cobrança, e o acesso era decidido
/// à parte por um enum no usuário — de modo que pagar não liberava nada
/// por si só, e não havia como um plano dar um curso e outro plano dar
/// outro.
model Plan {
  id        String  @id @default(cuid())
  nome      String
  /// Identificador estável para links e relatórios ("anual-2026").
  slug      String  @unique
  descricao String? @db.Text

  precoCentavos Int
  periodicidade Periodicidade @default(MENSAL)

  /// O plano gratuito da plataforma.
  ///
  /// Existe como plano de verdade, e não como condição especial no
  /// código: o administrador escolhe que cursos e módulos o acesso
  /// gratuito inclui, do mesmo jeito que faz com qualquer plano pago.
  ///
  /// Só um pode ser o gratuito ao mesmo tempo (garantido por índice
  /// parcial na migration): dois planos FREE simultâneos tornariam
  /// indefinido qual deles vale para quem não assinou nada.
  gratuito Boolean @default(false)

  /// Só para periodicidade UNICA: quantos dias de acesso a compra libera.
  /// Nulo num plano recorrente, onde o ciclo já define o prazo.
  diasAcesso Int?

  /// Dias de acesso gratuito que ESTE plano concede, quando é o gratuito.
  ///
  /// Campo separado de `diasAcesso` de propósito: aquele pertence ao ciclo de
  /// uma compra paga e é lido por `somarPeriodo` para calcular vencimento.
  /// Reaproveitá-lo aqui faria o mesmo número significar duas coisas conforme
  /// o plano fosse pago ou gratuito, e quem mexesse em cobrança depois teria
  /// de adivinhar qual.
  ///
  /// Nulo = usa `free.dias_padrao` das configurações, que segue sendo o
  /// padrão da plataforma. Preenchido, o plano manda. 0 = sem expiração.
  diasFree Int?

  /// Dias de teste antes da primeira cobrança. 0 = sem teste.
  diasTeste Int @default(0)

  /// Desligado, o plano para de ser oferecido, mas as assinaturas
  /// existentes seguem valendo: editar um plano nunca cancela vínculo.
  ativo    Boolean @default(true)
  publico  Boolean @default(true)
  destaque Boolean @default(false)
  ordem    Int     @default(0)

  /// Uma linha por benefício, exibida na landing.
  beneficios String[] @default([])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas Subscription[]
  cursos      PlanCourse[]

  @@index([ativo])
  @@index([gratuito])
  @@map("plans")
}

/// Um curso que um plano libera.
///
/// A abrangência mora aqui, e não no plano, porque o mesmo plano pode dar
/// um curso inteiro e apenas parte de outro — que é exatamente o controle
/// granular que faltava.
model PlanCourse {
  id       String @id @default(cuid())
  planId   String
  courseId String

  abrangencia AbrangenciaPlano @default(CURSO_COMPLETO)

  criadoEm DateTime @default(now())

  plan    Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Sem cascade: apagar um curso que planos vendem é erro, não intenção.
  course  Course       @relation(fields: [courseId], references: [id])
  modulos PlanModule[]

  /// Um curso aparece uma vez por plano. Duas linhas para o mesmo par
  /// tornariam ambígua a abrangência.
  @@unique([planId, courseId])
  @@index([courseId])
  @@map("plan_courses")
}

/// Um módulo específico liberado por um plano.
///
/// Só tem efeito quando a abrangência do `PlanCourse` é
/// MODULOS_ESPECIFICOS. Em CURSO_COMPLETO estas linhas são ignoradas de
/// propósito: guardá-las permite o administrador alternar a abrangência
/// para frente e para trás sem perder a seleção que já tinha feito.
model PlanModule {
  id           String @id @default(cuid())
  planCourseId String
  moduleId     String

  planCourse PlanCourse @relation(fields: [planCourseId], references: [id], onDelete: Cascade)
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planCourseId, moduleId])
  @@index([moduleId])
  @@map("plan_modules")
}

/// Assinatura de um aluno a um plano.
///
/// Os campos `gateway*` existem sem integração ativa: quando um meio de
/// pagamento entrar, ele grava o próprio identificador aqui sem precisar
/// de migration. Hoje o administrador lança tudo à mão.
model Subscription {
  id     String @id @default(cuid())
  userId String
  planId String

  status StatusAssinatura @default(ATIVA)

  /// Preço travado no ato da assinatura: reajustar o plano não reajusta
  /// quem já assinou. Aumento de preço é decisão explícita, não efeito
  /// colateral de uma edição.
  precoCentavos Int
  periodicidade Periodicidade

  inicioEm   DateTime  @default(now())
  /// Até quando o que já foi pago dá acesso.
  cicloFimEm DateTime?
  /// Vencimento da próxima cobrança. Nulo quando não há mais cobrança.
  proximaEm  DateTime?

  canceladoEm        DateTime?
  motivoCancelamento String?
  /// "aluno" ou "admin" — muda como tratamos o retorno da pessoa.
  canceladoPor       String?

  /// Cobranças vencidas seguidas. Zera a cada quitação e é o gatilho da
  /// suspensão por inadimplência.
  falhasSeguidas Int @default(0)

  /// Acesso sem data de término (vitalício, ou cortesia permanente).
  ///
  /// Precisa ser explícito: `cicloFimEm` nulo já significa "ainda não
  /// calculado", e usar o mesmo nulo para "nunca expira" tornaria
  /// impossível distinguir os dois casos.
  semExpiracao Boolean @default(false)

  /// Concedida pelo administrador, sem cobrança (bolsa, cortesia,
  /// parceria). Aparece no painel como concessão, não como venda, e não
  /// entra no faturamento.
  concedidaManualmente Boolean @default(false)

  gatewayProvedor String?
  gatewayId       String?
  gatewayStatus   String?

  observacoes String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Sem cascade: apagar um plano com assinatura é erro, não intenção.
  plan      Plan      @relation(fields: [planId], references: [id])
  cobrancas Payment[]

  // Um aluno pode ter VÁRIAS assinaturas ativas ao mesmo tempo, de
  // planos diferentes — o acesso efetivo é a união do que cada uma
  // libera. O que não pode é a mesma pessoa ter duas assinaturas vivas
  // do MESMO plano, que seria cobrança dobrada pelo mesmo conteúdo; isso
  // é barrado em `criarAssinatura`, e não por índice único, porque o
  // histórico precisa guardar as assinaturas encerradas do mesmo plano.
  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([proximaEm])
  @@map("subscriptions")
}

/// Lançamento financeiro de um aluno.
///
/// O controle é manual: não há integração com meio de pagamento.
/// Cada linha registra uma cobrança e, quando quitada, a data e a forma.
model Payment {
  id     String @id @default(cuid())
  userId String

  descricao     String
  valorCentavos Int
  tipo          TipoPagamento   @default(UNICO)
  status        StatusPagamento @default(PENDENTE)

  vencimentoEm DateTime
  pagoEm       DateTime?
  formaPagamento String?
  observacao     String?  @db.Text

  /// Para cobranças recorrentes: a competência (ex.: "2026-09").
  competencia String?

  /// Assinatura que originou esta cobrança. Nulo em lançamento avulso —
  /// uma taxa de material, por exemplo, não pertence a nenhum ciclo.
  subscriptionId String?

  gatewayId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// A assinatura sai de cena sem apagar o histórico de cobranças: o que
  /// já foi pago não pode desaparecer do relatório.
  assinatura Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([vencimentoEm])
  @@index([subscriptionId])
  @@map("payments")
}

// ============================================================
// TURMAS
// ============================================================

/// Como a turma acontece. ONLINE não tem endereço; PRESENCIAL tem local
/// fixo; HIBRIDA mistura, e aí cada encontro diz se é presencial ou remoto.
enum ModalidadeTurma {
  ONLINE
  PRESENCIAL
  HIBRIDA
}

/// Ciclo de vida da turma. Só INSCRICOES_ABERTAS aceita novo aluno pelo
/// código; CONCLUIDA e CANCELADA preservam o histórico sem deixar entrar.
enum SituacaoTurma {
  RASCUNHO
  INSCRICOES_ABERTAS
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Um encontro isolado pode fugir da modalidade da turma: numa turma
/// presencial, o encontro 3 pode ser remoto por causa de chuva.
enum ModalidadeEncontro {
  PRESENCIAL
  REMOTO
}

enum PresencaEncontro {
  PRESENTE
  FALTA
  JUSTIFICADA
}

model Cohort {
  id        String  @id @default(cuid())
  courseId  String
  nome      String
  descricao String? @db.Text
  inicioEm  DateTime?
  fimEm     DateTime?
  codigo    String  @unique // código de matrícula

  // ---- Como e onde acontece ----
  modalidade ModalidadeTurma @default(ONLINE)
  situacao   SituacaoTurma   @default(RASCUNHO)

  /// Nome do lugar ("EMEF Vila Nova"), não o endereço.
  local     String?
  endereco  String?
  cidade    String?
  uf        String?
  /// Sala, bloco, andar — o que falta para achar a porta.
  sala      String?
  /// Link da videochamada, para turma ONLINE ou encontro REMOTO.
  linkOnline String?

  // ---- Capacidade e responsável ----
  /// Nulo = sem limite. Ao lotar, o código para de aceitar inscrição.
  vagas       Int?
  instrutorId String?

  /// Anotações internas — nunca exibidas ao aluno.
  observacoes String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Instrutor sai da turma sem apagá-la: o vínculo apenas fica nulo.
  instrutor User?           @relation("TurmasQueMinistro", fields: [instrutorId], references: [id], onDelete: SetNull)
  membros   CohortMember[]
  encontros CohortMeeting[]

  @@index([courseId])
  @@index([situacao])
  @@index([instrutorId])
  @@map("cohorts")
}

/// Um encontro da turma — a aula com data e hora marcadas.
model CohortMeeting {
  id       String @id @default(cuid())
  cohortId String
  /// 1, 2, 3... Ordena a lista e nomeia ("Encontro 2") quando não há tema.
  ordem    Int
  titulo   String?
  /// O que será tratado neste encontro.
  pauta    String? @db.Text

  /// Dia do encontro. A hora fica nos campos abaixo, como texto "HH:MM",
  /// para não depender do fuso do servidor ao exibir "19:00".
  data         DateTime
  horaInicio   String?
  horaFim      String?

  modalidade ModalidadeEncontro @default(PRESENCIAL)
  /// Sobrescrevem o local da turma quando este encontro é em outro lugar.
  local      String?
  endereco   String?
  sala       String?
  linkOnline String?

  /// Encontro remarcado ou cancelado continua na lista, com o aviso.
  canceladoEm DateTime?
  motivoCancelamento String?

  criadoEm DateTime @default(now())

  cohort   Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  presencas MeetingAttendance[]

  @@unique([cohortId, ordem])
  @@index([data])
  @@map("cohort_meetings")
}

/// Presença de um aluno num encontro. A ausência de registro significa
/// "ainda não chamado", diferente de FALTA.
model MeetingAttendance {
  id        String           @id @default(cuid())
  meetingId String
  userId    String
  situacao  PresencaEncontro @default(PRESENTE)
  anotacao  String?

  registradoEm DateTime @default(now())

  meeting CohortMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_attendances")
}

model CohortMember {
  id       String   @id @default(cuid())
  cohortId String
  userId   String
  entrouEm DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@map("cohort_members")
}

// ============================================================
// CONTEÚDO DA LANDING PAGE
// ============================================================

/// Uma seção da página inicial, editável pelo painel.
///
/// As seções são fixas — cada `chave` corresponde a um bloco que o código
/// sabe desenhar. O painel edita textos, ordem e visibilidade; não cria
/// layout novo. Isso é deliberado: um construtor de páginas genérico
/// custaria dez vezes mais e permitiria quebrar o desenho da página.
///
/// `LandingItem` guarda as listas (os cards, os encontros, as
/// ferramentas), porque essas repetem estrutura e precisam de ordenação
/// própria.
model LandingSection {
  id    String @id @default(cuid())
  chave String @unique

  /// Nome mostrado ao administrador ("Chamada final"), não ao visitante.
  rotulo String

  /// Os textos do bloco. Nulos caem no valor embutido no código, então a
  /// página nunca aparece vazia por falta de conteúdo salvo.
  titulo    String? @db.Text
  subtitulo String? @db.Text
  texto     String? @db.Text
  /// Rótulo e destino do botão principal do bloco.
  ctaTexto  String?
  ctaLink   String?
  /// Segundo botão, quando o bloco tem dois.
  cta2Texto String?
  cta2Link  String?
  /// Faixa acima do título ("Formação de 40 horas · Rede pública").
  selo      String?
  imagem    String?
  video     String?

  visivel Boolean @default(true)
  ordem   Int     @default(0)

  atualizadoEm  DateTime @updatedAt
  atualizadoPor String?

  itens LandingItem[]

  @@map("landing_sections")
}

/// Item de uma lista da landing: um card, um encontro, uma ferramenta,
/// um depoimento, uma pergunta do FAQ.
model LandingItem {
  id        String @id @default(cuid())
  sectionId String

  titulo String
  texto  String? @db.Text
  /// Segunda linha do item — "Você leva:" nos encontros, a resposta no
  /// FAQ, o cargo no depoimento.
  extra  String? @db.Text

  /// Nome do ícone 3D, quando o bloco usa ícone.
  icone  String?
  /// Cor de destaque do item, em hex.
  cor    String?
  /// Selo curto ("Gratuito", "Com limite").
  selo   String?
  imagem String?
  link   String?

  visivel Boolean @default(true)
  ordem   Int     @default(0)

  criadoEm DateTime @default(now())

  section LandingSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, ordem])
  @@map("landing_items")
}

// ============================================================
// NOTIFICAÇÕES
// ============================================================

/// Como a mensagem saiu (ou tentou sair) da plataforma.
enum CanalNotificacao {
  /// Só no painel do aluno.
  PLATAFORMA
  EMAIL
  /// Texto pronto para o administrador enviar pelo WhatsApp — a
  /// plataforma não envia sozinha.
  WHATSAPP
}

enum StatusNotificacao {
  PENDENTE
  ENVIADA
  FALHOU
  /// Registrada só na plataforma, sem envio externo a fazer.
  REGISTRADA
}

/// Uma mensagem para um aluno.
///
/// Fica gravada mesmo quando o envio falha: sem isso, "avisei essa pessoa
/// que o acesso ia vencer?" não tem resposta. O aluno vê `titulo` e
/// `corpo` no painel; `erro` é interno.
model Notification {
  id     String @id @default(cuid())
  userId String

  canal  CanalNotificacao  @default(PLATAFORMA)
  status StatusNotificacao @default(PENDENTE)

  /// Assunto estável para agrupar e não repetir ("free.expirando").
  assunto String
  categoria String @default("ESSENCIAL")
  titulo  String
  corpo   String @db.Text
  link    String?
  contentId String?

  /// Quem disparou. Nulo = a própria plataforma (regra automática).
  autorNome String?

  enviadoEm DateTime?
  lidoEm    DateTime?
  erro      String?   @db.Text

  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  content NotificationContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([userId, lidoEm])
  @@index([assunto])
  @@index([criadoEm])
  @@index([contentId])
  @@map("notifications")
}

model NotificationContent {
  id String @id @default(cuid())
  slug String @unique
  titulo String
  subtitulo String?
  corpo String @db.Text
  imagemUrl String?
  videoUrl String?
  icone String @default("notificacoes")
  categoria String @default("ESSENCIAL")
  prioridade Int @default(0)
  ctaRotulo String?
  ctaLink String?
  ctaExterno Boolean @default(false)
  publico String @default("todos")
  publicoId String?
  status String @default("RASCUNHO")
  publicarEm DateTime?
  expiraEm DateTime?
  criadoPor String?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  entregas Notification[]
  @@index([status, publicarEm])
  @@map("notification_contents")
}

enum TipoMissao {
  DIARIA
  SEMANAL
  ESPECIAL
}

model Mission {
  id        String @id @default(cuid())
  chave     String @unique
  titulo    String
  descricao String
  tipo      TipoMissao
  criterio  String
  alvo      Int
  icone     String @default("metas")
  recompensaTitulo String?
  lessonId  String?
  /// Nulo = missão de toda a plataforma (ex.: manter a ofensiva).
  courseId  String?
  ativo     Boolean @default(true)
  oculto    Boolean @default(false)
  iniciaEm  DateTime?
  terminaEm DateTime?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios UserMission[]
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ativo, tipo])
  @@index([lessonId])
  @@index([courseId])
  @@map("missions")
}

model UserMission {
  id        String @id @default(cuid())
  userId    String
  missionId String
  ciclo     String
  progresso Int @default(0)
  concluidoEm DateTime?
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId, ciclo])
  @@index([userId, concluidoEm])
  @@map("user_missions")
}

model UserReward {
  id       String @id @default(cuid())
  userId   String
  origem   String
  titulo   String
  icone    String @default("recompensas")
  recebidoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, origem])
  @@index([userId, recebidoEm])
  @@map("user_rewards")
}

model ActivityPerformance {
  id       String @id @default(cuid())
  userId   String
  lessonId String
  acertos  Int
  total    Int
  tentativa Int @default(1)
  registradoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, registradoEm])
  @@index([lessonId])
  @@map("activity_performances")
}

/// Preferências opcionais de engajamento. Avisos essenciais de acesso,
/// segurança e cobrança não passam por estes interruptores.
model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique

  lembretesEstudo Boolean @default(true)
  novosDesafios   Boolean @default(true)
  conquistas      Boolean @default(true)
  missoes         Boolean @default(true)

  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Um aparelho autorizado a receber notificação push.
///
/// O `endpoint` é a identidade do aparelho: o próprio navegador o gera e
/// ele é único, então é ele (e não o par usuário+aparelho) que leva a
/// restrição de unicidade. Uma pessoa costuma ter várias linhas aqui —
/// celular, tablet, computador — e todas recebem.
///
/// `p256dh` e `auth` são as chaves de criptografia que o navegador
/// entrega no ato da autorização. Sem elas o Push Service aceita a
/// mensagem mas o aparelho não consegue abrir o conteúdo.
///
/// Quando o Push Service responde 404 ou 410, a inscrição morreu (app
/// desinstalado, permissão revogada) e a linha é apagada: insistir em
/// endpoint morto só gera erro a cada disparo.
model PushSubscription {
  id     String @id @default(cuid())
  userId String

  endpoint String @db.Text
  p256dh   String
  auth     String

  /// Só para o administrador entender de onde vem a inscrição.
  agente String? @db.Text

  criadoEm     DateTime  @default(now())
  /// Último envio aceito pelo Push Service. Ajuda a ver inscrição morta
  /// que ainda não recebeu 410.
  ultimoEnvioEm DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// ===========================================================================
//  ACOMPANHE A AULA
//  O aluno acompanha o encontro pelo celular enquanto o professor apresenta:
//  vê o mesmo passo, com o prompt já preenchível e o botão que abre a IA.
//  Nasceu de um problema concreto da primeira aula — a turma se perdia só com
//  a projeção, e a aula parava para ensinar, um a um, a acessar as ferramentas.
// ===========================================================================

/// O roteiro de um encontro: a versão navegável dos slides.
model LessonScript {
  id        String  @id @default(cuid())
  /// Roteiro de uma turma específica, quando o conteúdo é só dela.
  cohortId  String?
  /// Ou preso a um encontro do calendário.
  meetingId String? @unique
  /// Curso a que o roteiro serve, quando não é de uma turma específica.
  courseId  String?

  titulo   String
  /// Encontro 1, 2, 3... Ordena a lista quando há vários roteiros.
  ordem    Int     @default(1)
  ativo    Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  passos  ScriptStep[]
  sessoes LiveSession[]
  course  Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([cohortId, ordem])
  @@index([courseId, ordem])
  @@map("lesson_scripts")
}

/// Um passo do roteiro — equivale a um slide da projeção.
model ScriptStep {
  id       String @id @default(cuid())
  scriptId String
  ordem    Int
  titulo   String

  /// O slide como está no deck do curso, desenhado com o CSS do deck —
  /// mesmo visual no projetor e no celular. Nulo só nos passos gravados
  /// antes da coluna existir; o seed preenche no deploy seguinte.
  html String?

  /// A seção da apostila que este slide trata — "1.1", "2.2". Vem do badge
  /// do próprio slide ("Capítulo 2.2 · O coração do curso"); quando o slide
  /// não traz badge, herda o do anterior, que é o que a aula faz de fato.
  /// Serve ao botão que leva o aluno do slide direto ao trecho do material.
  secaoApostila String?

  /// A leitura estruturada do mesmo slide: texto, prompt, ferramenta,
  /// checklist, imagem. Não é mais o que se desenha, e sim o que o painel
  /// do professor consegue perguntar ("quantos marcaram este item?").
  /// Fica em JSON porque a combinação muda de passo para passo — em tabelas
  /// separadas, montar uma tela exigiria quatro joins para algo que é
  /// sempre lido inteiro de uma vez.
  blocos Json

  script   LessonScript   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  progresso StepProgress[]

  @@unique([scriptId, ordem])
  @@map("script_steps")
}

/// Um capítulo da apostila do curso.
///
/// A apostila é conteúdo do curso, como o roteiro da aula: chega pronta no
/// deploy, gravada pelo seed a partir de `apostila.ts`. Fica no banco, e não
/// como arquivo servido, porque a aplicação precisa consultá-la por seção
/// ("mostre 2.2") para levar o aluno do slide ao trecho certo.
model HandbookChapter {
  id String @id @default(cuid())

  /// "cap-1", "anexo-a" — é o que aparece no endereço.
  chave String @unique
  /// Apostila a que o capítulo pertence. Nulo = a de Educadores, que
  /// era a única quando a apostila foi para o banco.
  courseId String?
  /// 1, 2, 3… Nulo nos anexos, que não são numerados.
  numero Int?
  titulo String
  icone  String @default("")

  /// O que vem antes da primeira seção: aquecimento, abertura do capítulo.
  /// Em capítulos sem subdivisão (o Guia de Bolso, o Glossário) é o conteúdo
  /// inteiro, e não uma introdução.
  aberturaHtml String @default("")

  /// Ordena os capítulos como estão na apostila impressa.
  ordem Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  secoes HandbookSection[]
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ordem])
  @@index([courseId])
  @@map("handbook_chapters")
}

/// Uma seção de capítulo — "1.1 O que é Inteligência Artificial?".
model HandbookSection {
  id        String @id @default(cuid())
  chapterId String

  /// "1.1", "2.2". É por aqui que o slide encontra o trecho dele.
  numero String
  titulo String
  /// O trecho da apostila como está no material, com os boxes e as tabelas.
  html   String

  ordem Int

  chapter HandbookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, ordem])
  @@index([numero])
  @@map("handbook_sections")
}

/// Uma apresentação acontecendo agora.
///
/// Criada quando o professor abre o modo apresentação e encerrada quando ele
/// fecha. É o que diz ao aluno em que passo o professor está — sem o professor
/// precisar publicar nada à mão: avançar o slide já atualiza `passoAtual`.
model LiveSession {
  id        String  @id @default(cuid())
  scriptId  String
  /// Encontro do calendário, quando a apresentação está ligada a um.
  meetingId String?

  passoAtual Int @default(1)

  iniciadaEm  DateTime  @default(now())
  encerradaEm DateTime?

  script LessonScript @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  /// A busca do aluno é sempre "sessão aberta deste encontro".
  @@index([meetingId, encerradaEm])
  @@index([scriptId, encerradaEm])
  @@map("live_sessions")
}

/// O que cada aluno marcou e digitou num passo.
///
/// Serve ao painel do professor ("7 ainda não criaram conta") e ao próprio
/// aluno, que reencontra o que escreveu ao voltar a um passo.
model StepProgress {
  id     String @id @default(cuid())
  userId String
  stepId String

  /// Índices dos itens de checklist que o aluno marcou.
  marcados Int[] @default([])
  /// O que ele digitou nos campos do prompt: { "ANO": "6º ano" }. Sem isso,
  /// trocar de passo apagaria o que ele escreveu.
  valores  Json?

  visto DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  step ScriptStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([stepId])
  @@map("step_progress")
}
